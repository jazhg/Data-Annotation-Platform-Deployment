POSTGRES_DB=annotation_platform
POSTGRES_USER=annotation_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Required by config.settings / the production container.
# Generate a random value of at least 50 characters; do not reuse this placeholder.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=
# Set to 1 only behind a trusted TLS proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
# Supabase: copy the Session pooler parameters from the dashboard Connect panel.
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.<project-ref>
# POSTGRES_HOST=<session-pooler-host>
# POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
SUPABASE_PRIVATE_SCHEMA=1
